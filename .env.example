# LibraNia Environment Configuration
# Copy this file to .env and fill in your values

# ============================================
# Server Configuration
# ============================================

# Port for the HTTP server (default: 3000)
LIBRANIA_PORT=3000

# Host address to bind to (default: localhost)
LIBRANIA_HOST=localhost

# CORS origin for frontend requests (default: http://localhost:5173)
CORS_ORIGIN=http://localhost:5173

# ============================================
# Data Paths
# ============================================

# Base directory for all data storage (default: ./data)
LIBRANIA_DATA_DIR=./data

# Full path to SQLite database file (overrides LIBRANIA_DATA_DIR)
# If not set, uses LIBRANIA_DATA_DIR/librania.db
LIBRANIA_DB_PATH=./data/librania.db

# Directory for uploaded files and attachments (default: ./data/uploads)
LIBRANIA_UPLOAD_DIR=./data/uploads

# ============================================
# Security
# ============================================

# Master encryption key for API key storage
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LIBRANIA_MASTER_KEY=<generate-random-key>

# ============================================
# AI Provider API Keys
# ============================================

# Claude (Anthropic)
CLAUDE_API_KEY=<your-claude-api-key>
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# OpenAI
OPENAI_API_KEY=<your-openai-api-key>
OPENAI_MODEL=gpt-4

# DeepSeek
DEEPSEEK_API_KEY=<your-deepseek-api-key>
DEEPSEEK_MODEL=deepseek-chat

# ============================================
# Optional Services
# ============================================

# Tavily API for web search (optional)
TAVILY_API_KEY=<optional-tavily-api-key>
