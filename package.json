{
  "name": "librania",
  "version": "0.1.0",
  "type": "module",
  "description": "AI-Powered Knowledge Management with Multi-Model Verification",
  "keywords": [
    "knowledge-management",
    "ai",
    "cli",
    "notes",
    "graph"
  ],
  "main": "dist/backend/server.js",
  "bin": {
    "librania": "./bin/librania.js"
  },
  "files": [
    "bin/",
    "dist/backend/**/*.js",
    "dist/src/**/*.js",
    "!dist/**/*.test.js",
    "backend/extensions/",
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "author": "LibraNia Team",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=7.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build:frontend": "vite build",
    "build:backend": "tsc -p tsconfig.backend.json --noEmitOnError false || true",
    "build:package": "npm run build:frontend && npm run build:backend",
    "preview": "vite preview",
    "prepublishOnly": "npm run build:package",
    "postinstall": "npm rebuild better-sqlite3 sharp",
    "test": "vitest",
    "test:api": "tsx test-api.ts",
    "start:cli": "tsx bin/librania.js start"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.98.0",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/state": "6.6.0",
    "@codemirror/view": "^6.43.0",
    "@mapbox/node-pre-gyp": "^2.0.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@types/three": "^0.184.1",
    "@xenova/transformers": "^2.17.2",
    "better-sqlite3": "^12.10.0",
    "commander": "^14.0.3",
    "conf": "^15.1.0",
    "d3-force-3d": "^3.0.6",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.45.2",
    "duck-duck-scrape": "^2.2.7",
    "express": "^5.2.1",
    "file-type": "^21.3.4",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.460.0",
    "mammoth": "^1.12.0",
    "multer": "^2.1.1",
    "open": "^11.0.0",
    "openai": "^6.39.0",
    "pdf-parse": "^2.4.5",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-force-graph-2d": "^1.29.1",
    "react-force-graph-3d": "^1.29.1",
    "react-hot-toast": "^2.4.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.15.1",
    "react-select": "^5.10.2",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.3",
    "strip-indent": "^4.1.1",
    "three": "^0.184.0",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.12.0",
    "@types/react": "^19.0.6",
    "@types/react-dom": "^19.0.6",
    "@types/supertest": "^7.2.0",
    "@types/winston": "^2.4.4",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/ui": "^4.1.7",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.0.0",
    "jsdom": "^28.1.0",
    "prettier": "^3.4.0",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.22.3",
    "typescript": "^5.7.0",
    "vite": "^8.0.14",
    "vitest": "^4.1.7"
  }
}
